/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'WSIDATA_INGEST' {
        publishDir = [
            path: { "${params.outdir}/01_preprocessing/slides" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'LAZYSLIDE_FINDTISSUES' {
        publishDir = [
            path: { "${params.outdir}/01_preprocessing/tissue_masks" },
            mode: params.publish_dir_mode,
            pattern: '*.tissue.zarr',
            saveAs: { filename ->
                params.tissue_segmentation_method == 'otsu'
                    ? filename.replaceFirst(/\.otsu\.tissue\.zarr$/, '.tissue.zarr')
                    : filename
            }
        ]
    }

    withName: 'SQUIDPY_NORMALIZE' {
        publishDir = [
            path: { "${params.outdir}/01_preprocessing/normalized_slides" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.normalized.zarr') ? filename : null }
        ]
    }

    withName: 'LAZYSLIDE_TILETISSUES' {
        publishDir = [
            path: { "${params.outdir}/01_preprocessing/tiles" },
            mode: params.publish_dir_mode,
            pattern: '*.tiles.zarr'
        ]
    }

    withName: 'GRANDQC_TILETISSUES|SEGMENTATION_TILETISSUES|EMBEDDING_TILETISSUES|EMBEDDING_TILETISSUES_10X' {
        publishDir = [enabled: false]
    }

    withName: 'LAZYSLIDE_FEATUREEXTRACTION' {
        secret = {
            !workflow.stubRun && model in [
                'conceptclip', 'conch', 'conch-madeleine', 'conch_v1.5', 'crisp', 'crown',
                'gigapath', 'gigapath-flash', 'h-optimus-0', 'h-optimus-1', 'h0-mini', 'hibou-b', 'hibou-l',
                'mascaret', 'medsiglip', 'mstar', 'musk', 'open-midnight', 'path_orchestra', 'phaet',
                'rudolfv2', 'rudolfv2-b', 'rudolfv2-s', 'titan', 'uni', 'uni2', 'virchow', 'virchow2',
            ] ? ['HF_TOKEN'] : []
        }
        publishDir = [
            path: { "${params.outdir}/05_embeddings/tiles" },
            mode: params.publish_dir_mode,
            pattern: '*.embeddings.zarr'
        ]
    }

    withName: 'LAZYSLIDE_FEATUREAGGREGATION' {
        secret = { !workflow.stubRun && method in ['prism', 'titan'] ? ['HF_TOKEN'] : [] }
        publishDir = [
            path: { "${params.outdir}/05_embeddings/slides" },
            mode: params.publish_dir_mode,
            pattern: '*.slide_embedding.h5ad'
        ]
    }

    withName: 'LAZYSLIDE_SPATIALDOMAIN' {
        publishDir = [
            path: { "${params.outdir}/06_tissue_mapping/domains" },
            mode: params.publish_dir_mode,
            pattern: '*.tissue_domains.zarr'
        ]
    }

    withName: 'LAZYSLIDE_CELLS' {
        secret = { !workflow.stubRun && model in ['histoplus'] ? ['HF_TOKEN'] : [] }
        publishDir = [
            path: { "${params.outdir}/03_segmentation" },
            mode: params.publish_dir_mode,
            pattern: '*.cells.zarr'
        ]
    }

    withName: 'SPATIALDATA_SEGMENTATIONAGREEMENT' {
        publishDir = [
            path: { "${params.outdir}/03_segmentation" },
            mode: params.publish_dir_mode,
            pattern: '*.segmentation_agreement.csv'
        ]
    }

    withName: 'CYTOFORMER_CLASSIFY' {
        secret = { workflow.stubRun ? [] : ['HF_TOKEN'] }
        publishDir = [
            path: { "${params.outdir}/04_cell_types" },
            mode: params.publish_dir_mode,
            pattern: '*.cytoformer.zarr'
        ]
    }

    withName: 'SPATIALDATA_CELLTYPECOMPOSITION' {
        publishDir = [
            path: { "${params.outdir}/04_cell_types" },
            mode: params.publish_dir_mode,
            pattern: '*.cell_type_composition.csv'
        ]
    }

    withName: 'SQUIDPY_NEIGHBORHOODENRICHMENT' {
        publishDir = [
            path: { "${params.outdir}/04_cell_types" },
            mode: params.publish_dir_mode,
            pattern: '*.cell_neighborhoods.csv'
        ]
    }

    withName: 'LAZYSLIDE_TILEQC' {
        publishDir = [
            path: { "${params.outdir}/02_quality_control/tiles" },
            mode: params.publish_dir_mode,
            pattern: '*.zarr'
        ]
    }

    withName: 'LAZYSLIDE_GRANDQC' {
        publishDir = [
            path: { "${params.outdir}/02_quality_control/slides" },
            mode: params.publish_dir_mode,
            pattern: '*.zarr'
        ]
    }

    withName: 'SQUIDPY_NICHES' {
        publishDir = [
            path: { "${params.outdir}/04_cell_types" },
            mode: params.publish_dir_mode,
            pattern: '*.cell_niches.zarr'
        ]
    }

    withName: 'LAZYSLIDE_TISSUEREGIONS' {
        publishDir = [
            path: { "${params.outdir}/06_tissue_mapping/regions" },
            mode: params.publish_dir_mode,
            pattern: '*.tissue_regions.zarr'
        ]
    }

    withName: 'SPATIALDATA_CELLFEATURES' {
        publishDir = [
            path: { "${params.outdir}/07_cell_features" },
            mode: params.publish_dir_mode,
            pattern: '*.{cell_features.zarr,region_composition.csv}'
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/08_multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
