/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Runs a two-sample dataset with stain normalization, all tissue segmentation methods,
    cell segmentation, neighborhood enrichment, spatial cell niches, tile and slide embeddings,
    and tissue domain maps.
    The gated model downloads require an HF_TOKEN Nextflow secret with repository access.

    Use as follows:
        nextflow run nf-core/histopathology -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name            = 'Test profile'
    config_profile_description     = 'Two-sample test with stain normalization, all tissue segmentation methods, cell segmentation, neighborhood enrichment, spatial cell niches, tile and slide embeddings, and tissue domain maps'
    input                          = 'https://raw.githubusercontent.com/nictru/test-datasets/histopathology/samplesheet.csv'
    stain_reference                = 'sample-1'
    tissue_segmentation_method     = 'otsu,entropy,grandqc-tissue,hest-tissue-segmentation,pathprofiler'
    segmentation_model             = 'instanseg,nulite,histoplus'
    embedding_model                = 'resnet50,uni,uni2,gigapath-flash'
    slide_embedding_method         = 'mean,chief'
    tissue_domain_resolution       = 0.3
    cell_neighborhood_radius_um    = 30
    cell_neighborhood_permutations = 100
    cell_niche_radius_um           = 30
}
