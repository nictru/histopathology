nextflow_process {
    name "Test LAZYSLIDE_TILEQC"
    script "../main.nf"
    process "LAZYSLIDE_TILEQC"

    tag "modules"
    tag "modules_local"
    tag "lazyslide/tileqc"
    tag "lazyslide/tiletissues"
    tag "lazyslide/findtissues"
    tag "wsidata/ingest"

    test("Score the tile grid and retain an empty result for a blank slide") {
        setup {
            run("WSIDATA_INGEST") {
                script "../../../wsidata/ingest/main.nf"
                process {
                    """
                    def samples = ['tissue', 'blank'].collect { id ->
                        def image = new java.awt.image.BufferedImage(300, 270, java.awt.image.BufferedImage.TYPE_INT_RGB)
                        def graphics = image.createGraphics()
                        graphics.setColor(java.awt.Color.WHITE)
                        graphics.fillRect(0, 0, image.width, image.height)
                        if (id == 'tissue') {
                            graphics.setColor(new java.awt.Color(185, 90, 160))
                            graphics.fillOval(35, 45, 230, 180)
                            graphics.fillRect(215, 220, 85, 50)
                        }
                        graphics.dispose()
                        def source = java.nio.file.Files.createTempFile('lazyslide-' + id, '.tif')
                        assert javax.imageio.ImageIO.write(image, 'tiff', source.toFile())
                        [[id: id], source, [], 0.5]
                    }
                    input[0] = channel.fromList(samples)
                    """
                }
            }
            run("LAZYSLIDE_FINDTISSUES") {
                script "../../findtissues/main.nf"
                process {
                    """
                    input[0] = WSIDATA_INGEST.out.slide
                    """
                }
            }
            run("LAZYSLIDE_TILETISSUES") {
                script "../../tiletissues/main.nf"
                process {
                    """
                    input[0] = WSIDATA_INGEST.out.slide.join(LAZYSLIDE_FINDTISSUES.out.mask)
                    input[1] = 64
                    input[2] = 0.5
                    input[3] = 0.25
                    input[4] = 0.3
                    """
                }
            }
        }

        when {
            process {
                """
                def tiles = LAZYSLIDE_TILETISSUES.out.tiles.map { meta, store, _pixels -> [meta, store] }
                input[0] = WSIDATA_INGEST.out.slide.join(tiles)
                input[1] = 'tileqc'
                input[2] = []
                """
            }
        }

        then {
            assert process.success
            def previews = process.out.multiqc_files.collect { path(it).json }.sort { it.section_name }
            assert previews*.section_name == ['blank · Image metrics', 'tissue · Image metrics']
            assert previews*.parent_id.unique() == ['histopathology_tile_qc']
            assert previews*.plot_type == ['html', 'image']
            def results = process.out.tiles.sort { it[0].id }.collect { meta, store ->
                def attrs = path(path(store).resolve('zarr.json').toString()).json.attributes
                assert attrs.tile_qc.method == 'tileqc'
                def shapes = java.nio.file.Files.isDirectory(path(store).resolve('shapes/tiles'))
                [meta.id, shapes]
            }
            assert results == [['blank', false], ['tissue', true]]
            assert snapshot(results).match()
        }
    }

    ['focuslitenn', 'pathprofilerqc'].each { method ->
        test("Stage a ${method} checkpoint") {
            options "-stub-run"

            when {
                process {
                    """
                    def inputs = java.nio.file.Files.createTempDirectory('lazyslide-qc')
                    def slide = java.nio.file.Files.createDirectory(inputs.resolve('slide.zarr'))
                    def tiles = java.nio.file.Files.createDirectory(inputs.resolve('tiles.zarr'))
                    input[0] = [[id: 'sample'], slide, tiles]
                    input[1] = '${method}'
                    input[2] = java.nio.file.Files.createFile(inputs.resolve('model.pt2'))
                    """
                }
            }

            then {
                assert process.success
                def (meta, store) = process.out.tiles[0]
                assert meta.id == 'sample'
                def name = path(store).fileName.toString()
                assert name == "sample.${method}.zarr"
                assert snapshot(name).match()
            }
        }
    }
}
