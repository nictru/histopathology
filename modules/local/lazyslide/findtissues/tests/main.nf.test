nextflow_process {
    name "Test LAZYSLIDE_FINDTISSUES"
    script "../main.nf"
    process "LAZYSLIDE_FINDTISSUES"

    tag "modules"
    tag "modules_local"
    tag "lazyslide/findtissues"
    tag "wsidata/ingest"

    test("Write aligned tissue and blank masks") {
        setup {
            run("WSIDATA_INGEST") {
                script "../../../wsidata/ingest/main.nf"
                process {
                    """
                    def slides = ['tissue', 'blank'].collect { id ->
                        def image = new java.awt.image.BufferedImage(300, 270, java.awt.image.BufferedImage.TYPE_INT_RGB)
                        def graphics = image.createGraphics()
                        graphics.setColor(java.awt.Color.WHITE)
                        graphics.fillRect(0, 0, image.width, image.height)
                        if (id == 'tissue') {
                            graphics.setColor(new java.awt.Color(185, 90, 160))
                            graphics.fillOval(35, 45, 230, 180)
                        }
                        graphics.dispose()
                        def source = java.nio.file.Files.createTempFile('lazyslide-' + id, '.tif')
                        assert javax.imageio.ImageIO.write(image, 'tiff', source.toFile())
                        [[id: id], source, [], 0.5]
                    }
                    input[0] = channel.fromList(slides)
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = WSIDATA_INGEST.out.slide.combine(channel.of('otsu', 'entropy', 'grandqc-tissue'))
                """
            }
        }

        then {
            assert process.success
            def previews = process.out.multiqc_files.collect { path(it).json }.sort { it.section_name }
            assert previews*.section_name == ['blank · entropy', 'blank · grandqc-tissue', 'blank · otsu', 'tissue · entropy', 'tissue · grandqc-tissue', 'tissue · otsu']
            previews.each { preview ->
                assert preview.parent_id == 'histopathology_tissue'
                assert preview.plot_type == 'image'
                assert preview.data.contains('data:image/jpeg;base64,')
                if (preview.section_name.startsWith('blank')) {
                    assert preview.data.contains('No tissue detected.')
                }
            }
            def image_data = (previews.find { it.section_name == 'tissue · otsu' }.data =~ /data:image\/jpeg;base64,([^"]+)/)
            assert image_data.find()
            def image = javax.imageio.ImageIO.read(new ByteArrayInputStream(image_data.group(1).decodeBase64()))
            def center = new java.awt.Color(image.getRGB(image.width.intdiv(2), image.height.intdiv(2)))
            def background = new java.awt.Color(image.getRGB(image.width.intdiv(10), image.height.intdiv(10)))
            assert Math.abs(center.red - 125) < 10
            assert Math.abs(center.green - 120) < 10
            assert Math.abs(center.blue - 157) < 10
            assert [background.red, background.green, background.blue].every { it > 245 }

            assert process.out.mask.size() == 6
            def results = process.out.mask.sort { it[0].id }.collect { meta, mask, method ->
                assert path(mask).fileName.toString() == "${meta.id}.${method}.tissue.zarr"
                def root = path(path(mask).resolve('zarr.json').toString()).json
                assert root.attributes.tissue_detection.method == method
                def labels = path(mask).resolve('labels/wsi_tissue')
                def multiscale = path(labels.resolve('zarr.json').toString()).json.attributes.ome.multiscales[0]
                def shapes = multiscale.datasets.collect { level ->
                    def raster = path(labels.resolve(level.path).resolve('zarr.json').toString()).json
                    assert raster.chunk_grid.configuration.chunk_shape == [2048, 2048]
                    def sharding = raster.codecs.find { it.name == 'sharding_indexed' }
                    assert sharding?.configuration?.chunk_shape == [256, 256]
                    raster.shape
                }
                assert shapes == [[270, 300], [135, 150]]
                if (meta.id == 'blank') {
                    assert !root.attributes.tissue_detection.has_tissue
                }
                [meta.id, root.attributes.tissue_detection.has_tissue, method]
            }
            def otsu_results = results.findAll { it[2] == 'otsu' }.collect { it.take(2) }
            assert otsu_results == [['blank', false], ['tissue', true]]
            assert snapshot(otsu_results).match()
        }
    }
}
