nextflow_process {
    name "Test LAZYSLIDE_GRANDQC"
    script "../main.nf"
    process "LAZYSLIDE_GRANDQC"

    tag "modules"
    tag "modules_local"
    tag "lazyslide/grandqc"

    test("Stage the slide, tile grid, and model cache") {
        options "-stub-run"

        when {
            process {
                """
                def inputs = java.nio.file.Files.createTempDirectory('lazyslide-qc')
                def slide = java.nio.file.Files.createDirectory(inputs.resolve('slide.zarr'))
                def tiles = java.nio.file.Files.createDirectory(inputs.resolve('tiles.zarr'))
                input[0] = [[id: 'sample'], slide, tiles]
                input[1] = java.nio.file.Files.createDirectory(inputs.resolve('model-cache'))
                input[2] = '7x'
                """
            }
        }

        then {
            assert process.success
            def (meta, store) = process.out.artifacts[0]
            assert meta.id == 'sample'
            assert snapshot(path(store).fileName.toString()).match()
        }
    }
}
