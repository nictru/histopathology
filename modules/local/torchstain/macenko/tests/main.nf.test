nextflow_process {
    name "Test TORCHSTAIN_MACENKO"
    script "modules/local/torchstain/macenko/main.nf"
    process "TORCHSTAIN_MACENKO"

    tag "modules"
    tag "modules_local"
    tag "torchstain/macenko"
    tag "wsidata/ingest"

    test("Normalize an ingested WSIData store and record a blank-slide fallback") {
        setup {
            run("WSIDATA_INGEST") {
                script "../../../wsidata/ingest/main.nf"
                process {
                    """
                    def inputs = java.nio.file.Files.createTempDirectory('macenko-slides')
                    def tissue = new java.awt.image.BufferedImage(513, 301, java.awt.image.BufferedImage.TYPE_INT_RGB)
                    def blank = new java.awt.image.BufferedImage(513, 301, java.awt.image.BufferedImage.TYPE_INT_RGB)
                    (0..<tissue.height).each { y ->
                        (0..<tissue.width).each { x ->
                            def h = (x % 64) / 32.0
                            def e = (y % 64) / 32.0
                            def red = 255 * Math.exp(-(0.64 * h + 0.10 * e)) as int
                            def green = 255 * Math.exp(-(0.72 * h + 0.90 * e)) as int
                            def blue = 255 * Math.exp(-(0.25 * h + 0.44 * e)) as int
                            tissue.setRGB(x, y, (red << 16) | (green << 8) | blue)
                            blank.setRGB(x, y, java.awt.Color.WHITE.getRGB())
                        }
                    }
                    def tissuePath = inputs.resolve('tissue.tif').toFile()
                    def blankPath = inputs.resolve('blank.tif').toFile()
                    assert javax.imageio.ImageIO.write(tissue, 'tiff', tissuePath)
                    assert javax.imageio.ImageIO.write(blank, 'tiff', blankPath)
                    input[0] = channel.of(
                        [[id: 'tissue'], file(tissuePath), [], 0.5],
                        [[id: 'blank'], file(blankPath), [], 0.5],
                    )
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = WSIDATA_INGEST.out.slide
                """
            }
        }

        then {
            assert process.success
            def reports = process.out.slide.sort { it[0].id }.collect { meta, slide, report ->
                assert path(slide).fileName.toString() == "${meta.id}.normalized.zarr"
                assert java.nio.file.Files.isDirectory(path(slide).resolve('images/wsi'))
                def result = path(report).json
                assert result.mpp == 0.5
                assert result.level_shapes_yx[0] == [301, 513]
                assert result.level_shapes_yx.size() > 1
                assert result.calibration_patch_count == 64
                result.remove('brightness_scale')
                result
            }
            assert reports*.fallback == ['insufficient_tissue', null]
            assert process.out.versions.every { path(it).yaml.TORCHSTAIN_MACENKO.torchstain == '1.4.1' }
            assert snapshot(reports).match()
        }
    }
}
