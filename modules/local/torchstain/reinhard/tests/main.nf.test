nextflow_process {
    name "Test TORCHSTAIN_REINHARD"
    script "../main.nf"
    process "TORCHSTAIN_REINHARD"

    tag "modules"
    tag "modules_local"
    tag "torchstain/reinhard"
    tag "wsidata/ingest"

    test("Apply Modified Reinhard to a calibrated WSIData store") {
        setup {
            run("WSIDATA_INGEST") {
                script "../../../wsidata/ingest/main.nf"
                process {
                    """
                    def image = new java.awt.image.BufferedImage(300, 270, java.awt.image.BufferedImage.TYPE_INT_RGB)
                    (0..<image.height).each { y ->
                        (0..<image.width).each { x ->
                            image.setRGB(x, y, new java.awt.Color(140 + x % 110, 30 + y % 120, 150 + (x + y) % 80).getRGB())
                        }
                    }
                    def source_path = java.nio.file.Files.createTempFile('reinhard-query', '.tif')
                    assert javax.imageio.ImageIO.write(image, 'tiff', source_path.toFile())
                    input[0] = channel.of([[id: 'query'], source_path, [], 0.5])
                    """
                }
            }
        }

        when {
            process {
                """
                def reference = java.nio.file.Files.createTempFile('reinhard-reference', '.json')
                reference.toFile().text = '{"sample":"reference","method":"reinhardmodified","lab_means":[55,14,-3],"lab_stds":[12,8,7]}'
                input[0] = WSIDATA_INGEST.out.slide
                input[1] = reference
                input[2] = true
                input[3] = false
                """
            }
        }

        then {
            assert process.success
            def (meta, slide, report) = process.out.slide[0]
            assert meta.id == 'query'
            assert path(slide).fileName.toString() == 'query.normalized.zarr'
            assert java.nio.file.Files.isDirectory(path(slide).resolve('images/wsi'))
            assert path(process.out.versions[0]).yaml.TORCHSTAIN_REINHARD.torchstain == '1.4.1'
            def result = path(report).json
            assert snapshot(result.subMap(['method', 'reference_sample', 'mpp', 'level_shapes_yx', 'calibration_patch_count'])).match()
        }
    }

    test("Fit a reference from a calibrated WSIData store") {
        setup {
            run("WSIDATA_INGEST") {
                script "../../../wsidata/ingest/main.nf"
                process {
                    """
                    def image = new java.awt.image.BufferedImage(300, 270, java.awt.image.BufferedImage.TYPE_INT_RGB)
                    (0..<image.height).each { y ->
                        (0..<image.width).each { x ->
                            image.setRGB(x, y, new java.awt.Color(90 + x % 150, 60 + y % 120, 160 + (x + y) % 80).getRGB())
                        }
                    }
                    def source_path = java.nio.file.Files.createTempFile('reinhard-reference', '.tif')
                    assert javax.imageio.ImageIO.write(image, 'tiff', source_path.toFile())
                    input[0] = channel.of([[id: 'reference'], source_path, [], 0.5])
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = WSIDATA_INGEST.out.slide
                input[1] = []
                input[2] = false
                input[3] = true
                """
            }
        }

        then {
            assert process.success
            def (meta, reference) = process.out.reference[0]
            assert meta.id == 'reference'
            def result = path(reference).json
            assert result.lab_means.size() == 3
            assert result.lab_stds.size() == 3
            assert result.lab_stds.every { it > 0 }
            assert path(process.out.versions[0]).yaml.TORCHSTAIN_REINHARD.torchstain == '1.4.1'
            assert snapshot(result.subMap(['sample', 'method', 'calibration_patch_count'])).match()
        }
    }
}
