nextflow_process {
    name "Test SQUIDPY_NICHES"
    script "../main.nf"
    process "SQUIDPY_NICHES"

    tag "modules"
    tag "modules_local"
    tag "squidpy/niches"

    test("Emit distinct niche stores for native and CytoFormer predictions") {
        options "-stub-run"

        when {
            process {
                """
                def root = java.nio.file.Files.createTempDirectory('niche-inputs')
                def slide = java.nio.file.Files.createDirectory(root.resolve('sample.zarr'))
                input[0] = channel.fromList(['sample.classpose.cells.zarr', 'sample.classpose.cytoformer.zarr'].collect { name ->
                    [[id: 'sample'], java.nio.file.Files.createDirectory(root.resolve(name)), slide]
                })
                input[1] = 30
                input[2] = 0.5
                """
            }
        }

        then {
            assert process.success
            def stores = process.out.niches.collect { meta, store -> [meta.id, path(store).fileName.toString()] }.sort { it[1] }
            def plots = process.out.multiqc_files.flatten().collect { path(it).fileName.toString() }.sort()
            assert stores.size() == 2
            assert plots.size() == 4
            assert snapshot(stores, plots).match()
        }
    }
}
