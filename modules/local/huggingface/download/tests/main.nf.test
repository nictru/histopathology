nextflow_process {
    name "Test HUGGINGFACE_DOWNLOAD"
    script "../main.nf"
    process "HUGGINGFACE_DOWNLOAD"

    tag "modules"
    tag "modules_local"
    tag "huggingface/download"

    test("Download a pinned public file without a secret") {
        when {
            process {
                """
                input[0] = [[id: 'bert-config'], 'model', 'hf-internal-testing/tiny-random-bert', 'f171d7baecaf37b5da5a3616d8833b9969753535', 'config.json']
                """
            }
        }

        then {
            assert process.success
            def (meta, resource) = process.out.resource[0]
            assert meta.id == 'bert-config'
            assert path(resource).json.model_type == 'bert'
            assert snapshot([resource], process.out.versions_huggingface_hub).match()
        }
    }

    test("Stage a nested file - stub") {
        options "-stub-run"
        when {
            process {
                """
                input[0] = [[id: 'dataset-resource'], 'dataset', 'example/dataset', 'f171d7baecaf37b5da5a3616d8833b9969753535', 'nested/resource.txt']
                """
            }
        }
        then {
            assert process.success
            def (meta, resource) = process.out.resource[0]
            assert meta.id == 'dataset-resource'
            assert path(resource).parent.fileName.toString() == 'nested'
            assert snapshot([resource], process.out.versions_huggingface_hub).match()
        }
    }
}
