nextflow_workflow {

    name "Test Subworkflow SLIDE_CONVERT"
    script "../main.nf"
    workflow "SLIDE_CONVERT"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "subworkflows/slide_convert"
    tag "czi/totiff"
    tag "vips/tiffsave"

    test("Route mixed slide formats and combine the outputs") {
        options "-stub-run"

        when {
            workflow {
                """
                def inputs = java.nio.file.Files.createTempDirectory('slide-convert')
                def czi = java.nio.file.Files.createFile(inputs.resolve('heart.CZI'))
                def jpeg = java.nio.file.Files.createFile(inputs.resolve('heart.jpg'))
                def tiff = java.nio.file.Files.createFile(inputs.resolve('heart.tiff'))
                input[0] = channel.of(
                    [[id: 'czi'], czi, 0, null],
                    [[id: 'jpeg'], jpeg, null, 0.5],
                    [[id: 'tiff'], tiff, null, null],
                )
                """
            }
        }

        then {
            assert workflow.success
            def tasks = workflow.trace.tasks().collect { it.name.tokenize(':').last() }.sort()
            assert tasks == ['CZI_TOTIFF (czi)', 'VIPS_TIFFSAVE (jpeg)', 'VIPS_TIFFSAVE (tiff)']
            def slides = workflow.out.slides.collect { meta, slide, report ->
                [meta.id, path(slide).fileName.toString(), path(report).fileName.toString()]
            }.sort { it[0] }
            assert slides*.first() == ['czi', 'jpeg', 'tiff']
            assert snapshot(slides).match()
        }
    }
}
