nextflow_workflow {
    name "Test Subworkflow SEGMENTATION"
    script "../main.nf"
    workflow "SEGMENTATION"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "subworkflows/segmentation"
    tag "lazyslide/cells"
    tag "lazyslide/tiletissues"
    tag "spatialdata/segmentationagreement"

    ["reuse", "retile", "shared", "mixed"].each { mode ->
        test("Segmentation grid selection - ${mode}") {
            options "-stub-run"
            def models = [shared: ['cellpose', 'nulite'], mixed: ['cellpose', 'histoplus', 'instanseg', 'nulite']].get(mode, ['instanseg'])
            def samples = mode == 'mixed' ? ['sample', 'sample-2'] : ['sample']
            def target_mpp = mode == 'reuse' ? 0.9091 : 0.5

            when {
                workflow {
                    """
                    def inputs = java.nio.file.Files.createTempDirectory('slide-segmentation')
                    def slides = ${samples.inspect()}.collect { id ->
                        def normalized = java.nio.file.Files.createDirectory(inputs.resolve(id + '.normalized.zarr'))
                        def slide = java.nio.file.Files.createDirectory(inputs.resolve(id + '.zarr'))
                        def mask = java.nio.file.Files.createDirectory(inputs.resolve(id + '.tissue.zarr'))
                        def tiles = java.nio.file.Files.createDirectory(inputs.resolve(id + '.tiles.zarr'))
                        [[id: id], normalized, slide, mask, tiles]
                    }
                    input[0] = channel.fromList(slides).map { meta, normalized, slide, mask, tiles -> [meta, normalized] }
                    input[1] = channel.fromList(slides).map { meta, normalized, slide, mask, tiles -> [meta, slide, mask] }
                    input[2] = channel.fromList(slides).map { meta, normalized, slide, mask, tiles -> [meta, tiles] }
                    input[3] = ${mode in ['retile', 'mixed'] ? 256 : 512}
                    input[4] = ${target_mpp}
                    input[5] = 0.125
                    input[6] = 0.3
                    def selected_models = ${models.inspect()}
                    input[7] = selected_models
                    input[8] = ${target_mpp}
                    """
                }
            }

            then {
                assert workflow.success
                def tasks = workflow.trace.tasks().collect { it.name.tokenize(':').last().tokenize(' ').first() }.sort()
                def expected = [
                    reuse: ['LAZYSLIDE_CELLS'],
                    retile: ['LAZYSLIDE_CELLS', 'SEGMENTATION_TILETISSUES'],
                    shared: ['LAZYSLIDE_CELLS', 'LAZYSLIDE_CELLS', 'SEGMENTATION_TILETISSUES', 'SPATIALDATA_SEGMENTATIONAGREEMENT'],
                    mixed: ['LAZYSLIDE_CELLS'] * 8 + ['SEGMENTATION_TILETISSUES'] * 4 + ['SPATIALDATA_SEGMENTATIONAGREEMENT'] * 2,
                ]
                assert tasks == expected[mode]
                def results = workflow.out.cells.collect { meta, store ->
                    [meta.id, path(store).fileName.toString()]
                }
                def expected_results = samples.collectMany { id -> models.collect { model -> [id, id + '.' + model + '.cells.zarr'] } }
                assert results.sort { it[1] } == expected_results.sort { it[1] }
                def agreement = workflow.out.agreement.collect { meta, file ->
                    [meta.id, path(file).fileName.toString()]
                }.sort { it[0] }
                def compared_samples = models.size() > 1 ? samples : []
                assert agreement == compared_samples.collect { [it, it + '.segmentation_agreement.csv'] }
                def previews = workflow.out.multiqc_files.collect { path(it).fileName.toString() }.sort()
                def expected_previews = expected_results.collect { it[1].replace('.zarr', '_mqc.json') }
                expected_previews += compared_samples.collect { it + '.segmentation_agreement_mqc.json' }
                assert previews == expected_previews.sort()
                if (mode in ['reuse', 'retile']) {
                    assert snapshot(results).match()
                }
            }
        }
    }
}
