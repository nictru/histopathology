nextflow_workflow {
    name "Test TILE_EMBEDDINGS"
    script "../main.nf"
    workflow "TILE_EMBEDDINGS"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "subworkflows/tile_embeddings"
    tag "lazyslide/featureextraction"

    test("Run each selected encoder on every sample - stub") {
        options "-stub-run"

        when {
            workflow {
                """
                def inputs = java.nio.file.Files.createTempDirectory('embedding-inputs')
                def slides = ['slide-a', 'slide-b'].collect { id ->
                    def slide = java.nio.file.Files.createDirectory(inputs.resolve(id + '.zarr'))
                    def mask = java.nio.file.Files.createDirectory(inputs.resolve(id + '.tissue.zarr'))
                    def grid = java.nio.file.Files.createDirectory(inputs.resolve(id + '.tiles.zarr'))
                    [[id: id], slide, mask, grid]
                }
                input[0] = channel.fromList(slides).map { meta, slide, mask, grid -> [meta, slide] }
                input[1] = channel.fromList(slides).map { meta, slide, mask, grid -> [meta, slide, mask] }
                input[2] = channel.fromList(slides).map { meta, slide, mask, grid -> [meta, grid] }
                input[3] = 256
                input[4] = 0.5
                input[5] = 0
                input[6] = 0.3
                input[7] = ['resnet50', 'uni', 'uni2', 'lunit-bt', 'musk', 'conceptclip', 'conch_v1.5', 'chief', 'conch-madeleine']
                input[8] = 8
                input[9] = [chief: [256, 1.0], 'conch-madeleine': [256, 1.0]]
                """
            }
        }

        then {
            assert workflow.success
            def tasks = workflow.trace.tasks().collect { it.name.tokenize(':').last().tokenize(' ').first() }
            assert tasks.count('EMBEDDING_TILETISSUES') == 4
            assert tasks.count('EMBEDDING_TILETISSUES_10X') == 2
            assert tasks.count('LAZYSLIDE_FEATUREEXTRACTION') == 18
            assert tasks.size() == 24
            def stores = workflow.out.embeddings.collect { meta, store, model ->
                assert path(store).fileName.toString() == "${meta.id}.${model}.embeddings.zarr"
                path(store).fileName.toString()
            }.sort()
            def models = ['chief', 'conceptclip', 'conch-madeleine', 'conch_v1.5', 'lunit-bt', 'musk', 'resnet50', 'uni', 'uni2']
            assert stores == ['slide-a', 'slide-b'].collectMany { sample ->
                models.collect { model -> "${sample}.${model}.embeddings.zarr".toString() }
            }
            assert snapshot(stores).match()
        }
    }
}
